// Benchmarks

include "lib/util.tc";

int mil(int x) { return x * 1000 * 1000; }

void whileBench(int sz) {
    int i = mil(sz);
    print("while ("); printNum(i, 10); print(") ...");
    while (i) { i--; }
}

int fib(int n) {
    if (n<2) { return n; }
    return fib(n-1) + fib(n-2);
}

int fact(int n) {
    if (n < 2) { return 1; }
    return n * fact(n - 1);
}

int main() {
    whileBench(200); cr();
    print("fib(30): "); printNum(fib(30), 10); cr();
    print("fact(14): "); printNum(fact(14), 10); cr();
    return 0;
}
