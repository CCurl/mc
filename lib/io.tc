// io.tc - common I/O functions

void print(byte str[]) {
    int l,i;
    l = (str[1] * 256) + str[0]; i = 2;
    while (l) { emit(str[i]); i=i+1; l=l-1; }
}

void printNum(int n, int b) {
    if (n<0) { emit('-'); n = -n; }
    if (n > (b-1)) { printNum(n / b, b); }
    n = n % b;
    if (n > 9) { n = n+7; }
    emit(n+'0');
}
