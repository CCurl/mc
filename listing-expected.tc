// Golden test for the listing of generated code (make listing-test)

int gArr[4];
byte gStr[] = "abc";

int twice(int x) { return x + x; }

int main() {
    int i = 0;
    int sum = 0;
    while (i < 3) {
        gArr[i] = twice(i);
        sum = sum + gArr[i];
        i++;
    }
    return sum;
}
