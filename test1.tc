// Some simple benchmarks

void print(int str[]) {
    int i; i = 1;
    while (str[i]) { emit(str[i]); i = i + 1; }
}

void printNum(int n, int b) {
    if (n<0) { emit('-'); n = -n; }
    if (n > (b-1)) { printNum(n / b, b); }
    n = n % b;
    if (n > 9) { n = n+7; }
    emit(n+'0');
}

int mil(int n) { return n*1000*1000; }

int main() {
	int i, n;
	i = mil(100);
    print("while loop: "); printNum(i,10); print(" ...\n");
	while (i) { i=i-1; }
    print("done\n");
	i = n = 0;
	do { i=i+(n=n+1); } while (i<1000);
    printNum(n,10); print(" iterations\n");
	return 0;
}
