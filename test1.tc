// Some simple benchmarks

include "lib/io.tc";

int mil(int n) { return n*1000*1000; }

int main() {
	int i, n;
	i = mil(100);
    print("while loop: "); printNum(i,10); print(" ...\n");
	while (i) { i=i-1; }
    print("done\n");
	i = n = 0;
	do { i=i+(n=n+1); } while (i<1000);
    printNum(n,10); print(" iterations\n");
	return 0;
}
