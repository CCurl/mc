// Unit tests for the Tiny-C compiler and VM.
// Each check prints "name: ok" or "name: FAIL"; the last line prints the failure count.

include "lib/util.tc";

int failures, passes;
int gZero, gA, gB;
int gInit = 7, gInitNeg = -3, gInitExpr = 2 * 3 + 1;
byte gByteInit = 258, gByteNeg = -1;
byte gByte, gBytes[] = "abc";
int gArr[4];
byte gStr[] = "abc";
byte gPad[10] = "hi";
byte gEmpty[] = "";
byte gEsc[] = "\n\t\\\"";
int gCounter;
int gInc;
byte gEsc2[] = "\r\e\'";
byte gEsc3[] = "a\0b";
byte gCat[8] = "ab";
byte gLong[] = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz";
int globalInt, anotherGlobal, leading2, upperCase;
int charCode, newlineCode, escapeCode, quoteCode, backslashCode, outputCode, modResult;
int globalArr[10], nums[5];
byte cat[10] = "cat";
byte emptyString[] = "";
byte escapedString[] = "A\n\"\\\0";
byte greeting[] = "\ncat";
int gBigPad[40000];
int gAfterBig = 9;
byte gBigBytes[40000];
byte gAfterBytes = 3;
int gWide = 70000;
int gBefore[2];
byte gBetween[3];
int gAfter[2];

void check(byte name[], int ok) {
    print(name);
    if (ok) { print(": ok\n"); passes++; }
    else { print(": FAIL\n"); failures++; }
}

byte passByte(byte value) { return value; }
int promoteByte(byte value) { return value; }
byte narrowByte(int value) { return value; }
byte arrayByte(byte values[], int index) { return values[index]; }
void updateByteArray(byte values[]) { values[2] = 'Z'; }

// Global storage and string initializers.
void testGlobals() {
    check("global scalar is zero-initialized", gZero == 0);
    check("global array is zero-initialized", gArr[3] == 0);
    gA = 4;
    gB = gA + 1;
    check("multiple declarators are independent", gB == 5);
    check("inferred string length", gStr[0] == 3);
    check("inferred string high length byte", gStr[1] == 0);
    check("string first character", gStr[2] == 'a');
    check("string last character", gStr[4] == 'c');
    check("string terminator", gStr[5] == 0);
    check("sized string length", gPad[0] == 2);
    check("sized string high length byte", gPad[1] == 0);
    check("sized string padded with zero", gPad[9] == 0);
    check("empty string length", gEmpty[0] == 0);
    check("empty string high length byte", gEmpty[1] == 0);
    check("empty string terminator", gEmpty[2] == 0);
    check("escape string length", gEsc[0] == 4);
    check("newline escape", gEsc[2] == '\n');
    check("tab escape", gEsc[3] == '\t');
    check("backslash escape", gEsc[4] == '\\');
    check("quote escape", gEsc[5] == '"');
    check("escape string terminator", gEsc[6] == 0);
    check("int global scalar initializer", gInit == 7);
    check("negative int global initializer", gInitNeg == -3);
    check("constant expression global initializer", gInitExpr == 7);
    check("byte global initializer narrows", gByteInit == 2);
    check("negative byte global initializer wraps", gByteNeg == 255);
    gBigPad[39999] = 4;
    check("int global far into global memory is addressable", gBigPad[39999] == 4);
    check("int global far into global memory does not alias lower ones", gBigPad[14463] == 0);
    check("int global far into global memory keeps its value", gAfterBig == 9);
    gBigBytes[39999] = 200;
    check("byte global above byte 32767 is addressable", gBigBytes[39999] == 200);
    check("byte global above byte 32767 does not alias lower bytes", gBigBytes[14463] == 0);
    check("byte global above byte 32767 keeps its value", gAfterBytes == 3);
    check("int global holds a value above 16 bits", gWide == 70000);
    gBefore[1] = 111;
    gBetween[2] = 7;
    gAfter[0] = 222;
    check("byte write does not clobber preceding int array", gBefore[1] == 111);
    check("int write does not clobber following int array", gAfter[0] == 222);
    check("byte element between int arrays keeps its value", gBetween[2] == 7);
}

// Integer and character literals, unary minus.
void testLiterals() {
    check("decimal boundary 127 to 128", 127 + 1 == 128);
    check("decimal boundary 32767 to 32768", 32767 + 1 == 32768);
    check("large decimal literal", 65536 + 1 == 65537);
    check("char A", 'A' == 65);
    check("char newline", '\n' == 10);
    check("char carriage return", '\r' == 13);
    check("char tab", '\t' == 9);
    check("char NUL", '\0' == 0);
    check("char escape", '\e' == 27);
    check("char backslash", '\\' == 92);
    check("char single quote", '\'' == 39);
    check("char double quote", '"' == 34);
    check("unary minus", -5 == 0 - 5);
    check("double unary minus", - -5 == 5);
    check("unary minus on parenthesized sum", -(3 + 4) == 0 - 7);
}

void testByteTypes() {
    byte local, another;
    check("byte global is zero-initialized", gByte == 0);
    gByte = 258;
    check("byte global assignment narrows", gByte == 2);
    local = 258;
    check("int assignment narrows to byte", local == 2);
    check("byte assignment yields converted value", (local = 259) == 3);
    another = 255;
    check("byte conversion uses unsigned 8-bit values", another == 255);
    check("byte conversion wraps negative int", narrowByte(0 - 1) == 255);
    check("byte parameter converts int argument", passByte(258) == 2);
    check("byte promotes when passed to int parameter", promoteByte(255) == 255);
    check("byte return converts int result", narrowByte(255) == 255);
    check("byte arithmetic promotes to int", another + 2 == 257);
    check("byte array stores narrow values", (gBytes[2] = 258) == 2);
    gBytes[3] = 255;
    check("byte array reads unsigned value", gBytes[3] == 255);
    check("byte array parameter reads elements", arrayByte(gBytes, 3) == 255);
    updateByteArray(gBytes);
    check("byte array parameter writes elements", gBytes[2] == 'Z');
    check("string literal passed to byte array parameter",
          arrayByte("abc", 2) == 'a');
}

void testArithmetic() {
    check("addition", 7 + 3 == 10);
    check("subtraction", 7 - 3 == 4);
    check("multiplication", 7 * 3 == 21);
    check("division", 7 / 3 == 2);
    check("modulo", 7 % 3 == 1);
    check("division truncates toward zero", -7 / 2 == -3);
    check("modulo sign follows dividend", -7 % 3 == -1);
    check("left-to-right subtraction", 10 - 4 - 3 == 3);
    // sum() has no precedence; operators apply left to right.
    check("operators evaluate left to right", 2 + 3 * 4 == 20);
    check("parentheses override order", 2 + (3 * 4) == 14);
}

void testComparisons() {
    int x, y, hits, count;
    check("less than true", 3 < 4);
    check("less than false", (4 < 3) == 0);
    check("greater than true", 4 > 3);
    check("greater than false", (3 > 4) == 0);
    check("less or equal true", 3 <= 4);
    check("less or equal at equal", 4 <= 4);
    check("less or equal false", (5 <= 4) == 0);
    check("greater or equal true", 4 >= 3);
    check("greater or equal at equal", 4 >= 4);
    check("greater or equal false", (3 >= 4) == 0);
    check("equal true", 5 == 5);
    check("equal false", (5 == 6) == 0);
    check("not equal true", 5 != 6);
    check("not equal false", (5 != 5) == 0);
    check("comparison results are 0 or 1", (1 < 2) + (2 < 3) == 2);
    check("comparison of sums", 1 + 1 < 2 + 1);
    x = 4; y = 4; hits = 0;
    if (x <= y) { hits = hits + 1; }
    if (x >= y) { hits = hits + 1; }
    if (x <= y - 1) { hits = hits + 10; }
    if (x >= y + 1) { hits = hits + 10; }
    check("runtime <= and >= in if", hits == 2);
    count = 0;
    while (count <= 3) { count = count + 1; }
    check("while with <=", count == 4);
    count = 9;
    do { count = count - 1; } while (count >= 5);
    check("do with >=", count == 4);
    check("runtime <= and >= as values", ((x <= y) + (x >= y) + (x <= y - 1)) == 2);
}

void testAssignment() {
    check("assignment yields its value", (gA = 5) == 5);
    gA = gB = 9;
    check("chained assignment inner", gB == 9);
    check("chained assignment outer", gA == 9);
    gArr[1] = 7;
    check("array element assignment", gArr[1] == 7);
    gArr[0] = gArr[2] = 3;
    check("chained array assignment", gArr[0] == 3);
    check("array index expression", gArr[1 + 1] == gArr[2]);
}

void testControlFlow() {
    int i, n, r = 0, a, b;
    if (1) r = 1;
    check("if true", r == 1);
    r = 0;
    if (0) r = 1;
    check("if false", r == 0);
    if (0) r = 1; else r = 2;
    check("if else takes else", r == 2);
    a = 1; b = 0; r = 0;
    if (a) if (b) r = 1; else r = 2;
    check("else binds to nearest if", r == 2);
    r = 0;
    if (1) ; else r = 9;
    check("empty statement", r == 0);
    { { r = 3; } }
    check("nested blocks", r == 3);
    i = 0; n = 0;
    while (i < 10) { n = n + (++i); }
    check("while loop sums 1 to 10", n == 55);
    n = 0;
    while (0) n = 1;
    check("while with false condition", n == 0);
    n = 0;
    do n++; while (0);
    check("do while runs once", n == 1);
    i = 0; n = 0;
    do { n = n + (++i); } while (i < 3);
    check("do while loop", n == 6);
}

int add(int a, int b) { return a + b; }
int sub(int a, int b) { return a - b; }

void maybeSet(int value) {
    if (value) { return; }
    gCounter = 1;
}

int countAndReturn() {
    gCounter++;
    return 7;
}

int bump(int x) { return ++x; }

int fact(int n) {
    if (n < 2) { return 1; }
    return n * fact(n - 1);
}

int firstOver(int limit) {
    int i = 0;
    while (i < 100) {
        if (++i > limit) { return i; }
    }
    return 0;
}

// Calls to a function defined later in the file.
int forwardCaller() { return forwardCallee(4); }
int forwardCallee(int x) { return x * 10; }

// Global declared after functions.
int gLate;

void testFunctions() {
    int n;
    check("argument order", sub(10, 3) == 7);
    check("nested calls", sub(add(5, 5), 3) == 7);
    gCounter = 0;
    maybeSet(1);
    check("void early return skips rest", gCounter == 0);
    maybeSet(0);
    check("void body runs without return", gCounter == 1);
    gCounter = 0;
    countAndReturn();
    check("int call as statement", gCounter == 1);
    check("int call as value", countAndReturn() == 7);
    n = 3;
    check("parameter passed by value", bump(n) == 4);
    check("caller variable unchanged", n == 3);
    check("recursion", fact(5) == 120);
    check("return from inside loop", firstOver(5) == 6);
    check("forward reference", forwardCaller() == 40);
    gLate = 3;
    check("global declared after functions", gLate == 3);
}


void fill(int arr[], int count) {
    int i = 0;
    while (i < count) { arr[i] = twice(i++); }
}

int sum(int arr[], int count) {
    int i = 0, total = 0;
    while (i < count) { total = total + arr[i++]; }
    return total;
}

int sumForward(int arr[], int count) { return sum(arr, count); }
int firstChar(byte s[]) { return s[2]; }
void put(int index, int arr[], int value) { arr[index] = value; }

void testArrays() {
    fill(gArr, 4);
    check("array parameter writes caller array", gArr[3] == 6);
    check("array parameter reads caller array", sum(gArr, 4) == 12);
    check("array parameter forwarded", sumForward(gArr, 4) == 12);
    put(2, gArr, 9);
    check("array parameter after scalar", gArr[2] == 9);
    check("string literal as array argument", firstChar("xyz") == 'x');
    check("string literal length", strlen("hello") == 5);
    check("long string length above 255", strlen(gLong) == 260);
    check("long string last character", gLong[261] == 'z');
    strcatc(gCat, 'c');
    check("strcatc appends a character", strlen(gCat) == 3);
    check("strcatc character is at index 4", gCat[4] == 'c');
    check("strcatc keeps terminator", gCat[5] == 0);
}

// emit() prints the newline and returns the byte written.
void testEmit() {
    check("emit returns written byte", emit('*') == '*');
}

int twice(int x) { return x * 2; }
int seven() { return 7; }
int getAt(int arr[], int i) { return arr[i]; }
int incGlobal() { return ++gCounter; }

int ordered(int a, int b, int c, int d, int e, int f, int g, int h) {
    return a + (b * 10) + (c * 100) + (d * 1000) + (e * 10000) + (f * 100000) + (g * 1000000) + (h * 10000000);
}

int localsMix(int a, int b, int c) {
    int p, q;
    p = a + c;
    q = b * 2;
    return p * 100 + q;
}

int lateDecl(int x) {
    x = x + 1;
    int y;
    y = x * 2;
    return y;
}

int shadowLocal(int x) { int gA = x; return gA; }
int shadowParam(int gB) { return gB + 1; }

int depth(int n) {
    if (n < 1) { return 0; }
    return 1 + depth(n - 1);
}

// Defined after isEven, so isEven uses a forward reference.
int isEven(int n) {
    if (n == 0) { return 1; }
    return isOdd(n - 1);
}

int isOdd(int n) {
    if (n == 0) { return 0; }
    return isEven(n - 1);
}

int nestedReturn(int x) {
    if (x > 0) { while (1 == 1) { return x; } }
    return 0;
}

int sign(int x) {
    if (x < 0) { return -1; }
    else { if (x > 0) { return 1; } else { return 0; } }
}

int passTwo(int arr[]) { return sumForward(arr, 4); }
int passThree(int arr[]) { return passTwo(arr); }

void testCalls() {
    check("call inside binary expression", 1 + twice(2) == 5);
    check("two calls in one expression", twice(3) * twice(2) - twice(1) == 22);
    check("call with pending operand below", 100 - add(1, 2) == 97);
    check("nested calls as arguments", sub(add(1, twice(2)), twice(3)) == -1);
    gArr[1] = 5;
    check("array and scalar args with call", getAt(gArr, twice(0) + 1) == 5);
    gArr[twice(1)] = 9;
    check("call as array index in store", gArr[2] == 9);
    check("call as array index in load", gArr[twice(1)] == 9);
    check("call inside expression with loop exit", 1 + firstOver(3) == 5);
    check("eight arguments in order", ordered(1, 2, 3, 4, 5, 6, 7, 8) == 87654321);
    check("zero-argument call as value", seven() + seven() == 14);
    seven();
    check("zero-argument call as statement", seven() == 7);
    gCounter = 0;
    while (incGlobal() < 3) { }
    check("call in loop condition", gCounter == 3);
    check("emit in argument list", twice(emit('\n')) == 20);
}

int localInits(int x) {
    int a = x, b = a + 1;
    byte c = 300;
    return a + b + c;
}

int byteLocalFromParam(int x) { byte b = x; return b; }

int initInLoop(int n) {
    int total = 0, i = 0;
    while (i < n) {
        int step = i * 2;
        total = total + step;
        i = i + 1;
    }
    return total;
}

void testLocals() {
    check("local initializers see earlier declarators", localInits(1) == 47);
    check("byte local initializer narrows", byteLocalFromParam(300) == 44);
    check("negative byte local initializer wraps", byteLocalFromParam(-1) == 255);
    check("local initializer runs each loop pass", initInLoop(4) == 12);
    check("locals across statements", localsMix(1, 2, 3) == 404);
    check("declaration after statements", lateDecl(3) == 8);
    gA = 77;
    check("local shadows global", shadowLocal(5) == 5);
    check("global unchanged by shadowing local", gA == 77);
    check("parameter shadows global", shadowParam(4) == 5);
}

void testRecursion() {
    check("factorial of 10", fact(10) == 3628800);
    check("deep recursion of 200 levels", depth(200) == 200);
    check("mutual recursion even true", isEven(10) == 1);
    check("mutual recursion odd true", isOdd(7) == 1);
    check("mutual recursion even false", isEven(7) == 0);
    check("return from nested while", nestedReturn(5) == 5);
    check("return from nested if false path", nestedReturn(0) == 0);
    check("sign negative", sign(-5) == -1);
    check("sign zero", sign(0) == 0);
    check("sign positive", sign(7) == 1);
}

void testLiterals2() {
    check("negative multiply", -3 * 4 == -12);
    check("negative divide", 12 / -4 == -3);
    check("large product", 200 * 300 == 60000);
    check("large constant arithmetic", 70000 - 1 == 69999);
    check("carriage return escape in string", gEsc2[2] == 13);
    check("escape e in string", gEsc2[3] == 27);
    check("escaped single quote in string", gEsc2[4] == 39);
    check("string terminator after escapes", gEsc2[5] == 0);
    check("NUL escape inside string", gEsc3[3] == 0);
    check("character after NUL escape", gEsc3[4] == 'b');
}

void testArrays2() {
    fill(gArr, 4);
    check("array parameter through three levels", passThree(gArr) == 12);
    gArr[0] = 1;
    gArr[3] = 2;
    check("first element of global array", gArr[0] == 1);
    check("last element of global array", gArr[3] == 2);
}

int longJumpLoop() {
    int i, n;
    i = 0;
    n = 0;
    while (i < 3) {
        i = i + 1;
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
    }
    return n;
}

int longJumpIf(int x) {
    int n;
    n = 0;
    if (x > 0) {
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
        n = n + 1; n = n + 1; n = n + 1; n = n + 1; n = n + 1;
    }
    return n;
}

void testLongJumps() {
    check("loop body over 127 bytes", longJumpLoop() == 60);
    check("if body over 127 bytes taken", longJumpIf(1) == 20);
    check("if body over 127 bytes skipped", longJumpIf(0) == 0);
}

void nop() {}

void returnEarly(int shouldReturn) {
    if (shouldReturn) { return; }
    globalInt = globalInt + 100;
}

void statementForms(int limit) {
    int i = 0;
    ;
    while (i < limit) i = i + 1;
    do i = i - 1; while (i > 0);
    if (i == 0) globalInt = globalInt + 1;
    if (i > 0) ; else globalInt = globalInt + 1;
}

void setGlobal() { globalInt = 42; }
int getGlobal() { return globalInt; }
void writeSecond(int value, int items[]) { items[1] = value; }
int identity(int x) { return x; }

int mul(int left, int right) { return left * right; }
int div(int left, int right) { return left / right; }

int sumTo(int n) {
    int total, i;
    total = 0;
    i = 1;
    while (i < n + 1) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

int fib(int n) {
    n = n-1;
    if (n < 2) { return 1; }
    return (fib(n) + fib(n-1));
}

int arraySum(int values[], int count) {
    int total, i;
    total = 0;
    i = 0;
    while (i < count) {
        total = total + values[i];
        i = i + 1;
    }
    return total;
}

int setFirst(int items[], int value) {
    items[0] = value;
    return items[0];
}

int max2(int a, int b) {
    if (a > b) { return a; }
    else { return b; }
}

int parity(int x) {
    if (x < 0) { x = -x; }
    if (x == 0) { return 0; }
    return x % 2;
}

int isFalse(int value) { return value == 0; }

int modTest(int a, int b, int c) { return (a % b) == c; }

void testProgramFlow() {
    int localA;
    int localB;
    int localC;
    int localD;
    int localE;
    int i, j;
    printNum(12345, 16); emit('\n');
    printNum(-12345, 10);

    globalInt = 7;
    globalArr[0] = 10;
    globalArr[1] = 20;
    globalArr[2] = 30;
    globalArr[3] = 40;
    localA = globalArr[0];
    writeSecond(8, globalArr);
    leading2 = (2 + 3) * 4;
    upperCase = -1;
    charCode = 'A';
    newlineCode = '\n';
    escapeCode = '\e';
    quoteCode = '\'';
    backslashCode = '\\';
    localA = strlen(greeting);
    localB = greeting[3];
    globalInt = anotherGlobal = 7;

    nop();
    returnEarly(1);
    setGlobal();
    localA = getGlobal();
    statementForms(3);
    print(greeting);
    print("\nthis is a test");
    outputCode = emit('!');
    print("\nhi there\n");

    localA = identity(123);
    localB = add(3, 4);
    localC = sub(9, 4);
    localD = mul(6, 7);
    localE = div(20, 5);

    anotherGlobal = localA + localB + localC + localD + localE + globalInt;

    print("sum to 10: "); printNum(sumTo(10), 10); emit('\n');
    localB = fact(5);

    nums[0] = 5;
    nums[1] = 10;
    nums[2] = 15;
    nums[3] = 20;
    nums[4] = 25;
    writeSecond(identity(2 + 1), nums);
    i = 0;
    nums[i] = nums[i] + 1;

    localA = setFirst(nums, 99);
    localB = arraySum(nums, 5);
    localC = max2(11, 7);
    localD = parity(13);

    i = 0;
    j = 0;
    while (i < 5) {
        j = j + nums[i];
        i = i + 1;
    }

    do {
        localE = localE + 1;
    } while (localE < 20);

    if (localC == 11) { localA = 1; }
    else { localA = 2; }

    if (localD < 2) { localB = localB + 1; }

    strcatc(cat, 's');
    print(cat); cr();

    check("addition", add(3, 4) == 7);
    check("subtraction", sub(9, 4) == 5);
    check("multiplication", mul(6, 7) == 42);
    check("division", div(20, 5) == 4);
    check("modulo", modTest(123, 100, 23));
    check("negative modulo", -7 % 3 == -1);
    check("equality", 7 == 7);
    check("equality false", isFalse(7 == 8));
    check("inequality true", 7 != 8);
    check("inequality false", isFalse(7 != 7));
    check("character literal", charCode == 65);
    check("character escape", newlineCode == 10);
    check("escape character", escapeCode == 27);
    check("string length", strlen("ABC") == 3);
    check("string first character", greeting[3] == 'c');
    check("string terminator", greeting[6] == 0);
    check("empty string length", emptyString[0] == 0);
    check("empty string terminator", emptyString[2] == 0);
    check("global array reference", globalArr[1] == 8);
    check("recursive function fib(10)", fib(10) == 55);
    check("recursive function fact(5)", fact(5) == 120);
    check("while loop", j == 162);
    check("do while loop", localE == 20);
    check("if else", localC == 11);
    check("emit return", outputCode == '!');
    check("void side effects", getGlobal() == 44);
    check("void early return", getGlobal() == 44);
}

int mil(int n) { return n * 1000 * 1000; }

void testBenchmark() {
    int i, n;
    i = mil(100);
    while (i) { i--; }
    check("100 million iteration while loop completes", i == 0);
    i = n = 0;
    do { i = i + (++n); } while (i < 1000);
    check("do while sums to 1000 in 45 passes", n == 45);
}

int incParam(int n) { n++; return n; }
int incLocal() { int k = 3; k--; ++k; return k; }
int incByte() { byte b = 255; b++; return b; }
int decByte() { byte b = 0; --b; return b; }

void testIncDec() {
    int old;
    gInc = 5;
    gInc++;
    check("postfix increment statement on global", gInc == 6);
    old = gInc++;
    check("postfix returns old value", old == 6);
    check("postfix updates global", gInc == 7);
    check("prefix returns new value", (++gInc) == 8);
    check("prefix decrement on global", (--gInc) == 7);
    check("decrement and increment on local", incLocal() == 3);
    check("increment on parameter", incParam(4) == 5);
    check("byte increment wraps", incByte() == 0);
    check("byte decrement wraps", decByte() == 255);
}

int main() {
    testGlobals();
    testLiterals();
    testByteTypes();
    testArithmetic();
    testComparisons();
    testAssignment();
    testControlFlow();
    testFunctions();
    testArrays();
    testArrays2();
    testCalls();
    testLocals();
    testIncDec();
    testRecursion();
    testLiterals2();
    testLongJumps();
    testEmit();
    testProgramFlow();
    testBenchmark();
    print("\npassed: "); printNum(passes, 10);
    print(", failed: "); printNum(failures, 10);
    emit('\n');
    if (failures == 0) { print("all checks passed\n"); }
    else { printNum(failures, 10); print(" check(s) failed!\n"); }
    return 0;
}
