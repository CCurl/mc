int global_int, another_global, _leading2, UpperCase;
int char_code, newline_code, escape_code, quote_code, backslash_code, output_code, mod_result;
int global_arr[10], nums[5];
int greeting[] = "\ncat";
int cat[10] = "cat";
int empty_string[] = "";
int escaped_string[] = "A\n\"\\\0";

void nop() {}

void return_early(int should_return) {
    if (should_return) { return; }
    global_int = global_int + 100;
}

void set_global() { global_int = 42; }
int get_global() { return global_int; }

void write_second(int value, int items[]) {
    items[1] = value;
}

void statement_forms(int limit) {
    int i;
    i = 0;
    ;
    while (i < limit) i = i + 1;
    do i = i - 1; while (i > 0);
    if (i == 0) global_int = global_int + 1;
    if (i > 0) ; else global_int = global_int + 1;
}

int identity(int x) { return x; }
void cr() { emit('\n'); }
int strlen(int text[]) { return text[0]; }

void strcatc(int txt[], int c) {
    int len; len = txt[0]+1;
    txt[len] = c; txt[len+1] = 0;
    txt[0] = len;
}

void print(int str[]) {
    int i; i = 1;
    while (str[i]) { emit(str[i]); i = i + 1; }
}

void printNum(int n, int b) {
    if (n<0) { emit('-'); n = -n; }
    if (n > (b-1)) { printNum(n / b, b); }
    n = n % b;
    if (n > 9) { n = n+7; }
    emit(n+'0');
}

int add(int left, int right) { return left + right; }
int sub(int left, int right) { return left - right; }
int mul(int left, int right) { return left * right; }
int div(int left, int right) { return left / right; }

int sum_to(int n) {
    int total, i;
    total = 0;
    i = 1;
    while (i < n + 1) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

int fact(int n) {
    int result;
    if (n > 1) {
        result = n * fact(n - 1);
        return result;
    }
    return 1;
}

int fib(int n) {
    n = n-1;
    if (n < 2) { return 1; }
    return (fib(n) + fib(n-1));
}

int array_sum(int values[], int count) {
    int total, i;
    total = 0;
    i = 0;
    while (i < count) {
        total = total + values[i];
        i = i + 1;
    }
    return total;
}

int set_first(int items[], int value) {
    items[0] = value;
    return items[0];
}

int max2(int a, int b) {
    if (a > b) { return a; }
    else { return b; }
}

int parity(int x) {
    if (x < 0) { x = -x; }
    if (x == 0) { return 0; }
    return x % 2;
}


int isFalse(int value) { return value == 0; }

void passFail(int name[], int res) {
    print(name);
    if (res) { print(": pass\n"); }
    else { print(": fail\n"); }
}

int modTest(int a, int b, int c) { return (a % b) == c; }

int main() {
    int local_a;
    int local_b;
    int local_c;
    int local_d;
    int local_e;
    int i, j;
    printNum(12345, 16); emit('\n');
    printNum(-12345, 10);

    global_int = 7;
    global_arr[0] = 10;
    global_arr[1] = 20;
        global_arr[2] = 30;
    global_arr[3] = 40;
    local_a = global_arr[0];
    write_second(8, global_arr);
    _leading2 = (2 + 3) * 4;
    UpperCase = -1;
    char_code = 'A';
    newline_code = '\n';
    escape_code = '\e';
    quote_code = '\'';
    backslash_code = '\\';
    local_a = strlen(greeting);
    local_b = greeting[2];
    global_int = another_global = 7;

    nop();
    return_early(1);
    set_global();
    local_a = get_global();
    statement_forms(3);
    print(greeting);
    print("\nthis is a test");
    output_code = emit('!');
    print("\nhi there\n");

    local_a = identity(123);
    local_b = add(3, 4);
    local_c = sub(9, 4);
    local_d = mul(6, 7);
    local_e = div(20, 5);

    another_global = local_a + local_b + local_c + local_d + local_e + global_int;

    print("sum to 10: "); printNum(sum_to(10), 10); emit('\n');
    local_b = fact(5);

    nums[0] = 5;
    nums[1] = 10;
    nums[2] = 15;
    nums[3] = 20;
    nums[4] = 25;
    write_second(identity(2 + 1), nums);
    i = 0;
    nums[i] = nums[i] + 1;

    local_a = set_first(nums, 99);
    local_b = array_sum(nums, 5);
    local_c = max2(11, 7);
    local_d = parity(13);

    i = 0;
    j = 0;
    while (i < 5) {
        j = j + nums[i];
        i = i + 1;
    }

    do {
        local_e = local_e + 1;
    } while (local_e < 20);

    if (local_c == 11) { local_a = 1; }
    else { local_a = 2; }

    if (local_d < 2) { local_b = local_b + 1; }

    strcatc(cat, 's');
    print(cat); cr();

    passFail("addition", add(3, 4) == 7);
    passFail("subtraction", sub(9, 4) == 5);
    passFail("multiplication", mul(6, 7) == 42);
    passFail("division", div(20, 5) == 4);
    passFail("modulo", modTest(123, 100, 23));
    passFail("negative modulo", -7 % 3 == -1);
    passFail("equality", 7 == 7);
    passFail("equality false", isFalse(7 == 8));
    passFail("inequality true", 7 != 8);
    passFail("inequality false", isFalse(7 != 7));
    passFail("character literal", char_code == 65);
    passFail("character escape", newline_code == 10);
    passFail("escape character", escape_code == 27);
    passFail("string length", strlen("ABC") == 3);
    passFail("string first character", greeting[2] == 'c');
    passFail("string terminator", greeting[5] == 0);
    passFail("empty string length", empty_string[0] == 0);
    passFail("empty string terminator", empty_string[1] == 0);
    passFail("global array reference", global_arr[1] == 8);
    passFail("recursive function fib(10)", fib(10) == 55);
    passFail("recursive function fact(5)", fact(5) == 120);
    passFail("while loop", j == 162);
    passFail("do while loop", local_e == 20);
    passFail("if else", local_c == 11);
    passFail("emit return", output_code == '!');
    passFail("void side effects", get_global() == 44);
    passFail("void early return", get_global() == 44);

    return 0;
}
